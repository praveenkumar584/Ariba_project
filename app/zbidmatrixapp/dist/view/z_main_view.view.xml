<mvc:View controllerName="zbidmatrixapp.controller.z_main_view"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page">
        <customHeader>
            <Bar id="_IDGenBar">
                <contentLeft>
                    <HBox id="_IDGenHBox1">
                        <Image id="_IDGenImage" 
                            src="images/logo.png" 
                            width="150px" 
                            height="30px"
                            class="sapUiTinyMarginEnd customImage"/>
                        <Title id="_IDGenTitle1" text="{i18n>title}" level="H1" class="customTitle"/>
                    </HBox>
                </contentLeft>
            </Bar>
        </customHeader>
        <content>
            <VBox id="_IDGenVBox1" class="sapUiMediumMargin">
            <VBox id="_IDGenVBox" class="customFullBg" alignItems="Center" justifyContent="Center">
            <VBox id="_IDGenVBox2" alignItems="Center" class="sapUiSmallMarginBottom">
                <Input id="eventIdInput" placeholder="Enter Event ID (e.g. Doc123456)" width="350px" showClearIcon="true"/>
                <FlexBox id="_IDGenFlexBox" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop customFlexButtons" width="100%">
                    <items>
                        <Button id="_IDGenButton" text="Load Template" press="onLoadTemplate" type="Emphasized" />
                        <Button id="downloadBtn" text="Download" press="onDownload" enabled="false" icon="sap-icon://download" type="Ghost"/>
                        <Button id="docusignBtn" text="Docusign" press=".onOpenDocusignDialog" enabled="{dialogModel>/isButtonEnabled}" icon="sap-icon://paper-plane" type="Emphasized" />
                        <!-- <Button id="_IDGenButton3" text="Check Status" press="onCheckStatus"/> -->
                    </items>
                </FlexBox>
            </VBox>
                <BusyIndicator id="busyIndicator" visible="false" class="sapUiSmallMarginTop"/>
                <MessageStrip id="msgStrip" visible="false" class="sapUiSmallMarginTop"/>
            </VBox>

                <!-- Excel Preview Section - full width, same as before -->
                <core:HTML id="_IDGenHTML"
                    visible="false"
                    sanitizeContent="false"
                    content="&lt;div id='excelPreviewWrapper'&gt;
                        &lt;div id='sheetTabBar'&gt;&lt;/div&gt;
                        &lt;div id='excelTableContainer'&gt;
                            &lt;table id='excelTable'&gt;&lt;/table&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;"/>
            </VBox>
        </content>
    </Page>
</mvc:View>