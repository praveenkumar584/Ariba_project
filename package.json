{
  "name": "Z_BID_MATRIX",
  "version": "1.0.0",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.6.0",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap/cds": "^9.9.1",
    "@sap/xsenv": "^6.2.0",
    "@sap/xssec": "^4",
    "docusign-esign": "^9.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-zbidmatrixapp": "cds watch --open zbidmatrixapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy Z_BID_MATRIX --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "xsuaa"
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "ARIBA_API_Consumption": {
          "kind": "odata-v4",
          "credentials": {
            "destination": "ARIBA_API_Consumption",
            "requestTimeout": 30000
          }
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "ARIBA_API_Consumption": {
        "kind": "odata-v4"
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
