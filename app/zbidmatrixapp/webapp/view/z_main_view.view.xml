<mvc:View controllerName="zbidmatrixapp.controller.z_main_view"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page">
        <content>
            <Panel id="_IDGenPanel" class="customPanel1" >
                <VBox id="_IDGenVBox"  class="sapUiSmallMargin customVBox">
                    <HBox id="_IDGenHBox" alignItems="Center" class="myCellPadding1">
                        <Image id="_IDGenImage" src="{path:'imageModel>/logo'}" width="180px" class="sapUiLargeMarginEnd"/>
                        <VBox id="_IDGenVBox1">
                            <Title id="_IDGenTitle" text="BID Matrix Comparison" level="H2"/>
                            <Text id="_IDGenText" text="Enter a bid event ID to load the comparison template and analyze bidder responses."/>
                        </VBox>
                    </HBox>
                    <HBox id="_IDGenHBox1" class="customInputHBox">
                        <Label id="_IDGenLabel2" text="Bid Event ID :" required="true" width="100px"/>
                        <Input id="eventIdInput" width="500px" placeholder="Enter Bid Event ID (e.g. DOC12345678)" showClearIcon="true"/>
                    </HBox>
                </VBox>
            </Panel>
            <Panel id="_IDGenPanel1" headerText="Actions" class="myCellPadding">
                <HBox id="_IDGenHBox2" class="sapUiSmallMargin" justifyContent="Start" visible="true">
                    <Button id="_IDGenButton" text="Load Template" press="onLoadTemplate" type="Emphasized" width="150px" icon="sap-icon://document-text"/>
                    <Button id="editBtn" text="Edit" press="onEdit" type="Default" width="150px" icon="sap-icon://edit" enabled="false" class="sapUiTinyMarginBegin"/>
                    <Button id="downloadBtn" text="Download" press="onDownload" type="Ghost" width="150px" icon="sap-icon://download" enabled="false" class="sapUiTinyMarginBegin"/>
                    <Button id="docusignBtn" text="DocuSign" press=".onOpenDocusignDialog" type="Emphasized" width="150px" icon="sap-icon://signature" enabled="{dialogModel>/isButtonEnabled}" class="sapUiTinyMarginBegin"/>
                    <Button id="_IDGenButton3" text="Check Status" press="onCheckStatus" type="Ghost" width="150px" icon="sap-icon://process" enabled="false" class="sapUiTinyMarginBegin"/>
                </HBox>
                <BusyIndicator id="busyIndicator" visible="false" class="sapUiSmallMarginTop"/>
                <MessageStrip id="msgStrip" visible="false" class="sapUiSmallMarginTop"/>
                <VBox id="editActionContainer" visible="false" justifyContent="Start" width="100%">
                    <CheckBox id="consentCheck" text="I confirm that all manually entered values are correct." select="onConsentSelect" class="warningConsentCheck"/>
                    <HBox id="_IDGenHBox4">
                        <Button id="saveBtn" text="Save" type="Success" enabled="false" icon="sap-icon://save" press="onSave" class="sapUiTinyMarginBegin"/>
                        <Button id="cancelBtn" text="Cancel" class="sapUiTinyMarginBegin" icon="sap-icon://decline" press="onCancel" type="Negative"/>
                    </HBox>
                </VBox>
            </Panel>
            <VBox id="_IDGenVBox2" class="howItWorksContainer" visible="true" >
                <Toolbar id="_IDGenToolbar" design="Auto" class="sapUiSmallMarginBottom howItWorksHeader">
                    <Title id="_IDGenTitle1" text="How it works" level="H3"/>
                </Toolbar>
                <HBox id="_IDGenHBox3" justifyContent="SpaceAround" alignItems="Center" width="100%">
                    <VBox id="_IDGenVBox3" alignItems="Center" class="stepBox sapUiSmallMarginBegin">
                        <VBox id="_IDGenVBox14" class="stepCircle" justifyContent="Center" alignItems="Center">
                            <Text id="_IDGenText2" text="1"/>
                        </VBox>
                        <Text id="_IDGenText3" text="Enter Bid Event ID" class="stepTitle"/>
                        <Text id="_IDGenText4" text="Provide the Bid Event ID&#10;&#160;&#160;&#160;&#160;&#160;&#160;&#160;to get started." class="stepDesc"/>
                    </VBox>
                    <VBox id="_IDGenVBox5" class="stepLine"></VBox>
                    <VBox id="_IDGenVBox6" alignItems="Center" class="stepBox">
                        <VBox id="_IDGenVBox7" class="stepCircle" justifyContent="Center" alignItems="Center">
                            <Text id="_IDGenText5" text="2"/>
                        </VBox>
                        <Text id="_IDGenText6" text="Load Template" class="stepTitle"/>
                        <Text id="_IDGenText7" text="Load the comparison&#10;template for the event." class="stepDesc"/>
                    </VBox>
                    <VBox id="_IDGenVBox8" class="stepLine"></VBox>
                    <VBox id="_IDGenVBox9" alignItems="Center" class="stepBox">
                        <VBox id="_IDGenVBox10" class="stepCircle" justifyContent="Center" alignItems="Center">
                            <Text id="_IDGenText8" text="3"/>
                        </VBox>
                        <Text id="_IDGenText9" text="Compare &amp; Review" class="stepTitle"/>
                        <Text id="_IDGenText10" text="Review and compare&#10;&#160;&#160;&#160;bidder responses." class="stepDesc"/>
                    </VBox>
                    <VBox id="_IDGenVBox11" class="stepLine"></VBox>
                    <VBox id="_IDGenVBox12" alignItems="Center" class="stepBox">
                        <VBox id="_IDGenVBox13" class="stepCircle" justifyContent="Center" alignItems="Center">
                            <Text id="_IDGenText11" text="4"/>
                        </VBox>
                        <Text id="_IDGenText12" text="Take Action" class="stepTitle"/>
                        <Text id="_IDGenText13" text="Download, send for signature&#10;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;or check status." class="stepDesc"/>
                    </VBox>
                </HBox>
            </VBox>
            <core:HTML id="_IDGenHTML"
                    visible="false"
                    sanitizeContent="false"
                    content="&lt;div id='excelPreviewWrapper'&gt;
                        &lt;div id='sheetTabBar'&gt;&lt;/div&gt;
                        &lt;div id='excelTableContainer'&gt;
                        &lt;table id='excelTable'&gt;&lt;/table&gt;
                        &lt;/div&gt;
                        &lt;/div&gt;"/>
        </content>
    </Page>
</mvc:View>